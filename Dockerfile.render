# ============================================================
# All-In-One Render Container: MySQL + Spring Boot + React
# Ideal for Render 100% Free Plan (Single Web Service)
# ============================================================

# ── Stage 1: Build React Frontend ─────────────────────────
FROM node:18-alpine AS frontend-builder
WORKDIR /frontend
COPY banking-system/frontend/package*.json ./
RUN npm install
COPY banking-system/frontend/ ./
# Empty or relative API URL so requests route through current domain /api
ENV VITE_API_URL=/api
RUN npm run build

# ── Stage 2: Build Spring Boot Backend ─────────────────────
FROM maven:3.9.6-eclipse-temurin-21 AS backend-builder
WORKDIR /backend
COPY banking-system/backend/pom.xml ./
RUN mvn dependency:go-offline -B || true
COPY banking-system/backend/src ./src
RUN mvn clean package -DskipTests

# ── Stage 3: Unified Production Runtime ────────────────────
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install MariaDB (MySQL-compatible), OpenJDK 21, Nginx, and utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    mariadb-server \
    mariadb-client \
    openjdk-21-jre-headless \
    nginx \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy database initialization SQL scripts
COPY banking-system/database/ /docker-entrypoint-initdb.d/

# Copy built frontend into Nginx html root
COPY --from=frontend-builder /frontend/dist /var/www/html

# Copy compiled backend JAR
COPY --from=backend-builder /backend/target/*.jar /app/app.jar

# Copy entrypoint startup script
COPY start-render.sh /app/start-render.sh
RUN chmod +x /app/start-render.sh

# Render sets $PORT dynamically (defaults to 8080)
EXPOSE 8080

CMD ["/app/start-render.sh"]
