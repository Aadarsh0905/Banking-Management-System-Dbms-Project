# ============================================================
# Frontend Dockerfile - React 18 + Vite
# Built with Nginx for SPA routing
# ============================================================
FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependency specifications
COPY banking-system/frontend/package*.json ./
RUN npm install

# Copy frontend source code
COPY banking-system/frontend/ ./

# Accept API URL at build time (Vite embeds VITE_* vars at build)
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Build static production files (outputs to dist/)
RUN npm run build

# ── Production Web Server ──────────────────────────────────
FROM nginx:alpine

# Copy built static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Configure Nginx for React SPA (redirect all routes to index.html)
RUN echo 'server { \
    listen 80; \
    listen [::]:80; \
    server_name localhost; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
    error_page 500 502 503 504 /50x.html; \
    location = /50x.html { \
        root /usr/share/nginx/html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
